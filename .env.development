# Desarrollo LOCAL — default de `npm run dev` / `npm run tauri:dev` (Vite mode
# "development"). Apunta a TUS APIs locales en esta máquina. Tauri corre como
# app de escritorio en tu Mac, así que es `localhost` directo (no 10.0.2.2).
#
# Override personal (otro host/puertos): crea `.env.development.local`
# (gitignored por `*.local`) con tus propios VITE_URL_API / VITE_URL_API_V2.
#
# Equivale al `devlocal` del Android. Los otros entornos:
#   build:test       → `.env.test`        (server de pruebas: apidb / apidev)
#   build (prod)     → `.env.production`  (producción)

# Legacy node (sys_msp_backend) local.
VITE_URL_API=http://localhost:3000
# API Go (msp-api) local.
VITE_URL_API_V2=http://localhost:3001
# Versión mostrada (marca de build local).
VITE_APP_VERSION=1.13.2-local
# Google Maps JS API key para el mapa de ubicación del cliente. Se deja VACÍA
# aquí (este archivo está versionado — no metas el secreto). Pon tu key real en
# `.env.development.local` (gitignored por `*.local`). Sin key, el mapa muestra
# "Mapa no disponible" y no se hace ninguna petición a maps.googleapis.com.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase de desarrollo (msp-dev-96ff5). Sin estas, firebase.ts cae a PROD.
VITE_FIREBASE_API_KEY=AIzaSyAx9Ts4kGoqEmzDiI-mQCp8Jd4FZhczxos
VITE_FIREBASE_AUTH_DOMAIN=msp-dev-96ff5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=msp-dev-96ff5
VITE_FIREBASE_STORAGE_BUCKET=msp-dev-96ff5.appspot.com
VITE_FIREBASE_SENDER_ID=305734432149
VITE_FIREBASE_APP_ID=1:305734432149:web:placeholder

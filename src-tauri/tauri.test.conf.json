{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sistema Muebles San Pablo TEST",
  "version": "1.13.2-test.6",
  "identifier": "com.muebles-san-pablo.sistema.test",
  "build": {
    "beforeBuildCommand": "npm run build -- --mode test"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sistema Muebles San Pablo (TEST)",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "title": "Cargando...",
        "width": 400,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/abdimuy/sistema-cobro-web/releases/download/v1.13.2-test.6/latest.json"
      ]
    }
  }
}
